# Copy these values into your Windows user environment. Never commit real keys.
GROQ_API_KEY=your_groq_api_key_here
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_VOICE_MODEL=whisper-large-v3-turbo

# GitHub. OPTIONAL: if the GitHub CLI is installed, just say "connect my GitHub"
# and Muno runs the browser sign-in, then borrows that session. No token needed.
# Set this only to override that, e.g. for a scoped token.
# Scopes: 'repo' for repositories and files, 'workflow' to trigger Actions,
# 'delete_repo' only if you want Muno to be able to delete repositories.
# GITHUB_TOKEN=your_github_token_here

# Email. Most providers need an APP PASSWORD, not your normal password:
#   Gmail   https://myaccount.google.com/apppasswords
#   Yahoo   https://login.yahoo.com/account/security
#   iCloud  https://appleid.apple.com  (App-Specific Passwords)
#   Outlook https://account.microsoft.com/security
# The server is detected from your address, so hosts are only needed for
# uncommon providers or a self-hosted server.
# Muno prefers what is already signed in on this machine, so these are OPTIONAL.
# It tries, in order: your desktop mail client (no password), Gmail in its
# browser (no password), direct SMTP (needs the app password below), then your
# default mail app as a draft.
EMAIL_ADDRESS=you@gmail.com
EMAIL_PASSWORD=your_app_password_here
# Force one route: gmail | smtp | mailto | outlook
MUNO_EMAIL_BACKEND=auto
# The desktop mail client is off by default: it sends from its own configured
# account, not necessarily the address above. Set to 1 when you want to use it.
MUNO_EMAIL_USE_OUTLOOK=0

# Reuse the browser logins you already have instead of signing in again inside
# Muno's own profile. Chrome must be fully closed the first time Muno starts it.
# MUNO_CHROME_PROFILE=C:\Users\you\AppData\Local\Google\Chrome\User Data
# MUNO_CHROME_PROFILE_NAME=Default
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_IMAP_HOST=imap.example.com
# EMAIL_IMAP_PORT=993

# The curated collection Muno consults to work out which library provides a
# missing ability. Text only; no code from it is ever run.
MUNO_RECIPE_REPO=Shubhamsaboo/awesome-llm-apps
MUNO_RECIPE_BRANCH=main

# Optional: extra folders to include in Muno's file index, separated by ';'
MUNO_INDEX_ROOTS=D:\Work;E:\Archive

# Voice. Uses the Windows speech engine, so no key is needed.
MUNO_VOICE_ENABLED=1
# Narrate each action out loud. The activity log records steps either way.
MUNO_NARRATE=1
# Partial voice name, e.g. Zira or David. Leave blank for the system default.
MUNO_VOICE=
# Language for speech recognition. Pinning it is more accurate than letting the
# model guess, which is a common cause of nonsense transcripts for short phrases.
MUNO_VOICE_LANGUAGE=en
# For maximum accuracy use whisper-large-v3 instead of the turbo model, at the
# cost of some speed.
GROQ_VOICE_MODEL=whisper-large-v3-turbo
# Speaking pace, -10 (slow) to 10 (fast)
MUNO_VOICE_RATE=1
MUNO_VOICE_VOLUME=100

# Phone and tablet access. OFF by default: it exposes desktop control on your
# local network, protected by the pairing token in ~/.codex_pet/mobile_token.txt
MUNO_MOBILE=0
MUNO_MOBILE_PORT=8765
# Listen on every interface instead of just the LAN address. Needed if you want
# to reach it from localhost on this PC too.
MUNO_MOBILE_BIND_ALL=0
# Override the pairing token instead of using the generated one.
# MUNO_MOBILE_TOKEN=

# Proactive check-ins. Set to 0 to stop Muno commenting on your activity.
MUNO_CHECKINS=1
# Minimum seconds between check-ins (default 1800 = 30 minutes)
MUNO_CHECKIN_GAP=1800
# Seconds on one activity before Muno offers a nudge (default 2700 = 45 minutes)
MUNO_CHECKIN_TASK=2700
